{
  "name": "reversi-zero-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Play an agent that learned Reversi from self-play. The agent runs in your browser.",
  "scripts": {
    "dev": "node scripts/stage-runtime.mjs && concurrently -k -n build,serve -c blue,green \"vite build --watch\" \"vite preview\"",
    "build": "node scripts/stage-runtime.mjs && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "stage-runtime": "node scripts/stage-runtime.mjs",
    "dev:vite": "node scripts/stage-runtime.mjs && vite"
  },
  "dependencies": {
    "onnxruntime-web": "^1.20.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^10.0.5",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
